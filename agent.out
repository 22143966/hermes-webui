p='tests/test_session_touch_actions.py'
s=open(p).read()
old='''    cache_render_idx = archive_body.find(\"renderSessionListFromCache();\")'''
new='''    # The archive completion repaints as background churn through the helper
    # (gate L6) so a picker opened while the request was in flight survives.
    cache_render_idx = archive_body.find(\"_repaintSidebarAfterSessionCompletion(session.session_id);\")'''
assert s.count(old)==1
s=s.replace(old,new,1)
open(p,'w').write(s)

# 3. test_sidebar_pin_immediate_reorder.py
p='tests/test_sidebar_pin_immediate_reorder.py'
